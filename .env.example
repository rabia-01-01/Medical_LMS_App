# Optional: Supabase Connection Credentials
# If left unset, the app runs seamlessly in built-in offline/local mode.
# Obtain these from your Supabase Project Settings -> API if you want cloud sync.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Groq API Key for live AI generation at /api/ai/generate
# If left unset, AI MCQ Generator uses the built-in 350-question IMAT syllabus bank.
GROQ_API_KEY=

# Optional: Server Port (Render injects PORT automatically at runtime)
PORT=5000

# Optional: Comma-separated extra CORS origins if accessing API cross-domain
ALLOWED_ORIGINS=
